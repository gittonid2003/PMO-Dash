# Copy this file to .env and fill in real values. Never commit the real .env.

# Local Postgres example. For a hosted database, use the connection string
# your provider gives you (Render, etc.) instead.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aone_pmo_dev

# Set to false for local Postgres without SSL. Leave unset (or true) for
# any hosted database — Render's managed Postgres requires it.
DATABASE_SSL=false

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required at startup — the server refuses to start without a real one.
JWT_SECRET=

# development or production.
NODE_ENV=development

PORT=3000

# Optional. Whether the login cookie is marked Secure (HTTPS-only).
#   auto  (default) - Secure when the browser reached the app over HTTPS,
#                     including behind a reverse proxy that sends
#                     X-Forwarded-Proto: https; not Secure over plain http.
#   true  - always Secure. Use once the site is HTTPS-only. If set while the
#           app is opened over plain http://, browsers drop the cookie and
#           every login ends in "Could not load your data: Not logged in".
#   false - never Secure.
# COOKIE_SECURE=auto

# Optional. Only needed if a frontend on a DIFFERENT origin calls this API.
# Comma-separated list, e.g. https://pmo.atsuyatech.com. Leave unset normally.
# CORS_ORIGIN=
