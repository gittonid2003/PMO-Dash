# Settings for running with Docker (docker compose / deploy.sh).
# ./deploy.sh creates .env with random values automatically on a new install.
# To do it by hand: copy this file to .env and fill in the two values.

# Database password. Letters, numbers, - and _ only (it goes inside a
# connection URL). On an existing install it MUST stay the same, because the
# database was created with it.
POSTGRES_PASSWORD=

# Session-signing secret, 32+ random characters. Generate one with:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# Changing it later just logs everyone out once.
JWT_SECRET=

# Port the app is published on (http://server-address:PORT).
PORT=3000

# Optional, see server/.env.example. Leave unset unless the site is HTTPS-only.
# COOKIE_SECURE=auto
